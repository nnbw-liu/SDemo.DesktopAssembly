<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows 10 2004+：PerMonitorV2 DPI + WinForms NotifyIcon 托盘。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SDemo.Shell.Wpf</RootNamespace>
    <AssemblyName>SDemo.Shell.Wpf</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- 只借 WinForms 的 NotifyIcon / ContextMenuStrip，DPI 由 WPF 与 app.manifest 管理。 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SDemo.Shell.Contracts\SDemo.Shell.Contracts.csproj" />
    <ProjectReference Include="..\SDemo.Shell\SDemo.Shell.csproj" />
  </ItemGroup>

  <!-- UseWindowsForms 会注入全局 using，WPF 侧的 Application / MessageBox 会冲突，去掉。 -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
