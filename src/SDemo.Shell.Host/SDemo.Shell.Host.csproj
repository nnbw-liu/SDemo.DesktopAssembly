<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 组合根：单实例 + 启动时序 + 托盘消息循环。产物名按需求基线 DA-82 定为 SDemo.Shell.exe。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SDemo.Shell.Host</RootNamespace>
    <AssemblyName>SDemo.Shell</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SDemo.Shell.Contracts\SDemo.Shell.Contracts.csproj" />
    <ProjectReference Include="..\SDemo.Shell\SDemo.Shell.csproj" />
    <ProjectReference Include="..\SDemo.Shell.Wpf\SDemo.Shell.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
