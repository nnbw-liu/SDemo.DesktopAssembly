<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 壳核心：清单、存储、布局、注册表、回环监听器、进程管家；不依赖 WPF，可单测。 -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SDemo.Shell</RootNamespace>
    <!-- 核心程序集名用 .Core，避免与宿主 exe 的 SDemo.Shell.exe 在解决方案里同名（DA-82 要求 exe 名）。 -->
    <AssemblyName>SDemo.Shell.Core</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SDemo.Shell.Contracts\SDemo.Shell.Contracts.csproj" />
  </ItemGroup>

</Project>
