@namespace Spike.WidgetHost
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Spike Widget</title>
    <base href="/" />
    <style>
        html, body { margin: 0; height: 100%; }
        body {
            font-family: "Microsoft YaHei UI", system-ui, sans-serif;
            background: #101418; color: #e8edf2;
            display: flex; align-items: center; justify-content: center;
        }
        .card {
            width: 100%; height: 100%; box-sizing: border-box;
            padding: 20px; display: flex; flex-direction: column; gap: 12px;
            justify-content: center; align-items: flex-start;
        }
        #app { margin: 0; font-size: 22px; }
        #count { font-size: 40px; margin: 0; font-variant-numeric: tabular-nums; }
        button {
            font-size: 16px; padding: 8px 16px; border-radius: 8px;
            border: 1px solid #2f3a44; background: #1b2229; color: inherit;
        }
    </style>
</head>
<body>
    <Routes />
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
