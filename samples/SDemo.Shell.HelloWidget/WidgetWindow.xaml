<Window x:Class="SDemo.Shell.HelloWidget.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hello Widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="WidthAndHeight"
        Opacity="0.92"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Language="zh-CN">

    <!-- 圆角由 WPF 自绘：AllowsTransparency=true 即 WS_EX_LAYERED。置顶 / 穿透 / 屏幕坐标全部由宿主负责，应用不声明。 -->
    <Border x:Name="RootBorder"
            Width="320"
            Height="240"
            CornerRadius="14"
            BorderThickness="1"
            Background="#E61E2430"
            BorderBrush="#33FFFFFF"
            MouseLeftButtonDown="OnRootMouseLeftButtonDown">
        <Grid Margin="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题行：整窗可拖动。只放关闭按钮，不放最小化按钮（SC_MINIMIZE 在应用侧被忽略）。 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           Grid.Column="0"
                           Text="Hello Widget"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="#FFF3F6FA" />
                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Content="✕"
                        Width="24"
                        Height="24"
                        FontSize="11"
                        Padding="0"
                        Cursor="Hand"
                        ToolTip="关闭窗口"
                        Focusable="False"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#99C7D2E5"
                        Click="OnCloseButtonClick" />
            </Grid>

            <TextBlock Grid.Row="1"
                       x:Name="SubtitleText"
                       Margin="0,4,0,0"
                       Text="S1 样例：宿主管控 native 窗口"
                       FontSize="11"
                       Foreground="#B3C7D2E5" />

            <!-- 可输入文本框：验证点击后能打字，即窗口没有被 WS_EX_NOACTIVATE 弄成不可聚焦。 -->
            <TextBox x:Name="InputBox"
                     Grid.Row="2"
                     Margin="0,12,0,8"
                     Height="34"
                     Padding="10,0"
                     VerticalContentAlignment="Center"
                     FontSize="12"
                     Background="#1AFFFFFF"
                     BorderBrush="#33FFFFFF"
                     Foreground="#FFF3F6FA"
                     CaretBrush="#FFF3F6FA"
                     ToolTip="点击这里输入文字，验证宿主没有抢走焦点" />

            <!-- 计数按钮：点击 +1，验证点击 / 焦点链路正常。 -->
            <Button x:Name="CountButton"
                    Grid.Row="3"
                    Height="32"
                    HorizontalAlignment="Left"
                    Padding="14,0"
                    FontSize="12"
                    Cursor="Hand"
                    BorderThickness="0"
                    Background="#FF4C8DFF"
                    Foreground="White"
                    Content="点我 +1（0）"
                    Click="OnCountButtonClick" />

            <TextBlock x:Name="FooterText"
                       Grid.Row="4"
                       Margin="0,8,0,0"
                       FontSize="10"
                       HorizontalAlignment="Right"
                       Foreground="#80C7D2E5"
                       Text="127.0.0.1:0 · pid 0" />
        </Grid>
    </Border>
</Window>
