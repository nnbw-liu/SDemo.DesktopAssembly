<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- wasm 组件的最小样例进程：只声明 app.json 需要的 executable。
         组件本身由宿主渲染，这个进程只在被 ensure / MCP 需要时才会被拉起。 -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SDemo.Shell.WasmHello</RootNamespace>
    <AssemblyName>SDemo.Shell.WasmHello</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
