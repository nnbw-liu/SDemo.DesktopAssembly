{
  "schemaVersion": 1,
  "id": "sdemo.wasmhello.widget",
  "appId": "sdemo.wasmhello",
  "name": "Wasm Hello",
  "description": "S2 验收样例：宿主建窗 + WebView2 + 加载 payload\\index.html；布局全部由宿主执行。",
  "version": "0.1.0",
  "hostApiVersion": "1.0",

  "renderer": "wasm",
  "native": null,
  "wasm": {
    "webRoot": "payload",
    "entry": "index.html"
  },

  "size": { "width": 320, "height": 260 },

  "layer": "floating",

  "position": {
    "mode": "anchored",
    "corner": "bottom-right",
    "offsetX": 24,
    "offsetY": 24,
    "snapPx": 12,
    "rememberPerMonitor": true
  },

  "behavior": {
    "alwaysOnTopDefault": true,
    "dragMode": "app",
    "clickThrough": "never",
    "hideBehindFullscreenApp": true,
    "opacity": { "default": 1.0, "min": 1.0 },
    "keepAlive": "onDemand"
  },

  "focus": {
    "stealOnShow": false,
    "activateOnClick": true
  },

  "theme": {
    "mode": "auto",
    "followAccent": true,
    "surface": "opaque"
  },

  "activation": {
    "hotkey": "Ctrl+Alt+Shift+W",
    "launchOnStartup": false,
    "showInTray": true
  },

  "permissions": [],

  "config": {
    "type": "object",
    "properties": {
      "showSeconds": {
        "type": "boolean",
        "title": "显示秒",
        "default": true
      },
      "greeting": {
        "type": "string",
        "title": "问候语",
        "enum": ["你好", "Hello", "嗨"],
        "default": "你好"
      }
    }
  }
}
